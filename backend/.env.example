# ---------- required ----------
# (The publishable key is NOT needed here: it only goes into frontend/js/config.js)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME            # backend only. NEVER commit, NEVER put in the frontend

# ---------- strongly recommended ----------
# Free Helius key (helius.dev): fast RPC + enables the metadata check.
# Leave both blank to use the public Solana RPC (slow, rate limited).
HELIUS_API_KEY=
# SOLANA_RPC_URL=

# Free Jupiter key (portal.jup.ag): used by the sell simulation. Works keyless at a low rate limit.
JUPITER_API_KEY=
# JUPITER_API_URL=https://api.jup.ag/swap/v2

# ---------- feature switches (1 = on, 0 = off) ----------
ENABLE_LP_CHECK=1          # ~5 extra RPC calls per scan
ENABLE_HONEYPOT_SIM=1      # ~3-5 extra RPC calls + 1 Jupiter call per scan

# ---------- ingest worker ----------
MIN_LIQUIDITY_USD=1000
INGEST_INTERVAL_S=10
REFRESH_INTERVAL_S=20
REFRESH_MAX_TOKENS=150      # tokens younger than 24h refreshed every round
REFRESH_OLD_PER_LOOP=60    # older tokens refreshed per round (stalest first). 0 = don't refresh old tokens

# ---------- autoscan worker (OPTIONAL: off by default; start with run_local.py --autoscan) ----------
AUTOSCAN_BATCH=5
AUTOSCAN_DELAY_S=2.0
AUTOSCAN_IDLE_S=5

# ---------- API ----------
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SCAN_CACHE_TTL_S=180
MAX_CONCURRENT_SCANS=4
REQUESTS_PER_MIN=60
